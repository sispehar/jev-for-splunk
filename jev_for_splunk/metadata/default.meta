[]
access = read : [ * ], write : [ admin, sc_admin ]

# The command, its help and the macros are usable from any app (Search &
# Reporting included). Running | jev still requires the searching user's role
# to hold list_storage_passwords, because the command reads the TypeSafe key
# from storage/passwords with the user's own session.
[commands]
export = system

[searchbnf]
export = system

[macros]
export = system

# The judgment cache: readable and writable by the roles that can run | jev.
[collections/jev_cache]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system

[transforms/jev_cache_lookup]
access = read : [ admin, sc_admin ], write : [ admin, sc_admin ]
export = system
